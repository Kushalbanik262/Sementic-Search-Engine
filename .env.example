# Copy to .env and edit. Every key is optional; defaults live in config.py.

MODEL_NAME=BAAI/bge-small-en-v1.5
# DEVICE=cpu
MAX_SEQ_LENGTH=512
ENCODE_BATCH_SIZE=32

MAX_BATCH_ITEMS=128
MAX_CHARS_PER_TEXT=8000

MAX_CONCURRENT_ENCODES=1
ENCODE_QUEUE_TIMEOUT_S=30
# Cap torch to the cores you actually gave the container.
# TORCH_NUM_THREADS=4

# Set to require an X-API-Key header. Unset means auth is off.
# API_KEY=change-me
# JSON list, e.g. ["https://app.example.com"]
CORS_ALLOW_ORIGINS=[]
LOG_LEVEL=INFO

# --- message queue (python -m mq.worker) ---------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# query | index | query,index. Run query and index as separate replicas in
# production so a bulk backlog can never delay a search.
WORKER_LANES=index
# WORKER_ID=index-1                # defaults to hostname-pid
WORKER_SHUTDOWN_GRACE_S=30

# Query lane: latency first.
QUERY_PREFETCH=16
QUERY_BATCH_MAX_TEXTS=32
QUERY_BATCH_WINDOW_MS=5
QUERY_TTL_MS=5000
QUERY_MAX_LENGTH=1000

# Index lane: throughput first.
INDEX_PREFETCH=32
INDEX_BATCH_MAX_TEXTS=256
INDEX_BATCH_WINDOW_MS=50
# Total attempts before a failing job is dead-lettered to embedding.dead.
INDEX_DELIVERY_LIMIT=5
INDEX_RESULTS_QUEUE=indexer.results
